type tie<logic>
// ============================================================================
// format.tie：tsp（tie Language Server）——document formatting（p.6.9.11）
// 命名空间：tsp_fmt
//
// 纯文本格式化（**词法安全**：内部字符串/注释扫描器，不依赖编译器前端）：
//   · 2 空格缩进：按代码区 {} 深度增减（{ 增、} 减后再缩进该行；} 单独成行
//     时缩进为其外一层）
//   · 保留空行（连续空行压到最多 1 行）
//   · 行尾空白去除（仅代码行；字符串/注释内部行**一字节不改**）
//   · 文件末尾补一个换行（已有时不重复）
//   · 不做运算符空格规范化——只做缩进/空行/行尾
//
// 词法安全扫描器（跨行状态机；规范 §1.4/§1.9 全形态）：
//   "…"（转义生效）· r"…"（原始，无转义）· """…"""（多行）· h"…" / h"""…"""
//   （插值——本层整体视为字符串，花括号不改写）· // 与 ///（行注释）·
//   /* */（块注释，跨行）。花括号计数仅统计**代码区**；字符串/注释内部
//   的行（含多行字符串的中间行）保持原样。
//   （旧版只跳 " 与 //，多行字符串/块注释内的花括号会破坏缩进——已修。）
//
// 返回 LSP TextEdit[] JSON（整文档替换）；空文本或格式化结果与原文一致 →
// "[]"；幂等（对输出再格式化输出不变）。
//
// 本文件编译：随 server.tie 一起编译（server 主入口 import 本文件）或经
// probe_format.tie 单独编译验证（仅依赖 protocol.tie，无前端依赖）。
// ============================================================================

import "./protocol.tie" as proto

namespace tsp_fmt {

// 行起始偏移（line 0 基；越界返回文本长度；line < 0 返回 0）。
func line_start(txt: string, line: i64) -> i64 {
    var off: i64 = 0
    var ln: i64 = 0
    while ln < line && off < len(txt) {
        while off < len(txt) && str_byte(txt, off) != 10 {
            off = off + 1
        }
        if off < len(txt) {
            off = off + 1
        }
        ln = ln + 1
    }
    return off
}

// 按 \n 拆行（不含行尾换行符）。
func split_lines(s: string) -> table<string> {
    var out = table_new_string()
    var n = len(s)
    var i: i64 = 0
    var start: i64 = 0
    while i < n {
        if str_byte(s, i) == 10 {
            table_push(out, proto.substr_at(s, start, i))
            start = i + 1
        }
        i = i + 1
    }
    table_push(out, proto.substr_at(s, start, n))
    return out
}

func is_ws(c: string) -> bool {
    return c == " " || c == "\t" || c == "\r"
}

// 2 空格缩进串。
func indent_str(n: i64) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < n {
        sb_append(sb, "  ")
        i = i + 1
    }
    return sb_build(sb)
}

// 首个非空白字符为 }（代码区；用于 } 行缩进出层）。
func leading_close(content: string) -> i64 {
    var i: i64 = 0
    while i < len(content) && is_ws(str_char(content, i)) {
        i = i + 1
    }
    if i < len(content) && str_char(content, i) == "}" {
        return 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// 词法安全扫描：状态机（跨行）
//   st：0=代码 1="…" 2=r"…" 3="""…""" 4=/* */
// 返回 (行内代码区 open 数, close 数, 行末状态)。
// ---------------------------------------------------------------------------
func scan_code(ln: string, st0: i64) -> (i64, i64, i64) {
    var n = len(ln)
    var i: i64 = 0
    var st = st0
    var open: i64 = 0
    var close: i64 = 0
    while i < n {
        var b = str_byte(ln, i)
        if st == 0 {
            // 代码区：先看注释/字符串起始
            if b == 47 && i + 1 < n && str_byte(ln, i + 1) == 47 {
                break   // // 与 ///：行注释，余下不计
            }
            if b == 47 && i + 1 < n && str_byte(ln, i + 1) == 42 {
                st = 4
                i = i + 2
                continue
            }
            if b == 114 && i + 1 < n && str_byte(ln, i + 1) == 34 {
                st = 2
                i = i + 2
                continue
            }
            if b == 104 && i + 1 < n && str_byte(ln, i + 1) == 34 {
                // h""" 或 h"
                if i + 3 < n && str_byte(ln, i + 2) == 34 && str_byte(ln, i + 3) == 34 {
                    st = 3
                    i = i + 4
                    continue
                }
                st = 1
                i = i + 2
                continue
            }
            if b == 34 {
                if i + 2 < n && str_byte(ln, i + 1) == 34 && str_byte(ln, i + 2) == 34 {
                    st = 3
                    i = i + 3
                    continue
                }
                st = 1
                i = i + 1
                continue
            }
            if b == 123 {
                open = open + 1
            } else if b == 125 {
                close = close + 1
            }
            i = i + 1
        } else if st == 1 {
            // "…"：反斜杠转义跳两字节
            if b == 92 {
                i = i + 2
                continue
            }
            if b == 34 {
                st = 0
            }
            i = i + 1
        } else if st == 2 {
            // r"…"：无转义
            if b == 34 {
                st = 0
            }
            i = i + 1
        } else if st == 3 {
            // """…"""：三引号闭合
            if b == 34 && i + 2 < n && str_byte(ln, i + 1) == 34 && str_byte(ln, i + 2) == 34 {
                st = 0
                i = i + 3
                continue
            }
            i = i + 1
        } else {
            // 块注释：找 */
            if b == 42 && i + 1 < n && str_byte(ln, i + 1) == 47 {
                st = 0
                i = i + 2
                continue
            }
            i = i + 1
        }
    }
    return (open, close, st)
}

// 行尾空白去除（仅代码行调用）。
func trim_end(raw: string) -> string {
    var e = len(raw)
    while e > 0 && is_ws(str_char(raw, e - 1)) {
        e = e - 1
    }
    return proto.substr_at(raw, 0, e)
}

// 行首空白去除。
func trim_head(s: string) -> string {
    var b: i64 = 0
    while b < len(s) && is_ws(str_char(s, b)) {
        b = b + 1
    }
    return proto.substr_at(s, b, len(s))
}

// 文本中 \n 数量（= 0 基末行号）。
func count_nl(s: string) -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < len(s) {
        if str_char(s, i) == "\n" {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// 末行长度（末行 = 最后一个 \n 之后的部分）。
func last_line_len(s: string) -> i64 {
    var ls = line_start(s, count_nl(s))
    return len(s) - ls
}

// LSP 文档格式化：返回 TextEdit[] JSON（整文档替换）。
// 空文本或格式化结果与原文一致 → "[]"（无需改动）。
pub func format(uri: string, txt: string) -> string {
    if len(txt) == 0 {
        return "[]"
    }
    var lines = split_lines(txt)
    var out = table_new_string()
    var depth: i64 = 0
    var prev_blank: bool = false
    var st: i64 = 0
    var i: i64 = 0
    while i < len(lines) {
        var raw = lines[i]
        // 行首处于字符串/注释内部（含多行字符串中间行）→ 整行原样保留
        if st != 0 {
            table_push(out, raw)
            prev_blank = false
            var r2 = scan_code(raw, st)
            st = r2.2
            i = i + 1
            continue
        }
        var s2 = trim_end(raw)
        var content = trim_head(s2)
        if len(content) == 0 {
            // 空行：连续空行压到最多 1 行（保留首空行，后续连续空行跳过）
            if !prev_blank {
                table_push(out, "")
                prev_blank = true
            }
            i = i + 1
            continue
        }
        // 缩进深度 = 上一行未闭合 { 数 − 本行前导 } 数（不越 0）
        var lc = leading_close(content)
        var lvl = depth - lc
        if lvl < 0 {
            lvl = 0
        }
        table_push(out, indent_str(lvl) + content)
        prev_blank = false
        // 深度与状态更新（词法安全：字符串/注释内不计花括号）
        var sc = scan_code(content, st)
        depth = depth + sc.0 - sc.1
        if depth < 0 {
            depth = 0
        }
        st = sc.2
        i = i + 1
    }
    var result = join_lines(out, "\n") + "\n"
    if result == txt {
        return "[]"
    }
    var body = "[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":" +
        to_string(count_nl(txt)) + ",\"character\":" + to_string(last_line_len(txt)) +
        "}},\"newText\":" + proto.json_str(result) + "}]"
    return body
}

// 行数组 → 拼接（去尾零长度行；sep 连接；StringBuilder 原地追加）。
func join_lines(items: table<string>, sep: string) -> string {
    var n = len(items)
    while n > 0 && len(items[n - 1]) == 0 {
        n = n - 1
    }
    if n == 0 {
        return ""
    }
    var sb = string_builder()
    var i: i64 = 0
    while i < n {
        if i > 0 {
            sb_append(sb, sep)
        }
        sb_append(sb, items[i])
        i = i + 1
    }
    return sb_build(sb)
}

}   // namespace tsp_fmt
