type tie<logic>
// ============================================================================
// analyze.tie：tsp 分析核心（p.6.9.3）
// 命名空间：tsp_an
//
// 文档 → 编译流水线（复用编译器前端，0-Rust 收官）：
//   parser.parse_ast(src) + semantic.check_ast(base_dir)
//     → 词法/语法/语义错误（ERR:line col msg）→ LSP 诊断（range 映射）
//     → 语义警告（OK 协议 ;W:l c msg 段）→ LSP 警告诊断
//     → 符号索引（函数/struct/enum/全局/namespace + 位置 + 签名）
//     → import 图（g_imported 归一化路径清单）
//
// 单文件错误隔离：坏文档只产生该文件的诊断，不崩服务；错误后 sstate
// 处于部分状态，符号索引仅在 check 成功时重建。
// 增量：文件级缓存（文本指纹 → 诊断 JSON），didChange 文本未变不重算。
//
// 本文件编译：tiec compiler/lsp/analyze.tie -o tsp.exe（经 server.tie 汇总）
// 或随 server.tie 一起编译（server 是主入口，本文件被 import）。
// ============================================================================

import "../frontend/parser.tie"
import "../frontend/semantic.tie"
import "./protocol.tie" as proto

// ---- 前端树跨层全局 shim ----
// sinfer（frontend）引用 g_cur_fn_name，其声明在 backend/irgen.tie；
// LSP 只 import frontend 树（不 import backend），此处补声明。
var g_cur_fn_name: string = ""

// ---- AST 节点 tag 常量（对齐 frontend/ast.tie，本地定义防重复 import）----
const AN_VAR: i64 = 6
const AN_CALL: i64 = 7
const AN_PATH: i64 = 16
const AN_METHOD_CALL: i64 = 18
const AN_FIELD_ACCESS: i64 = 15
const AN_VAR_DECL: i64 = 100
const AN_FN_DEF: i64 = 101
const AN_EXPR_STMT: i64 = 102
const AN_IMPORT: i64 = 111
const AN_NAMESPACE: i64 = 112
const AN_STRUCT: i64 = 114
const AN_EXTERN: i64 = 117
const AN_PARAM: i64 = 118
const AN_STMTLIST: i64 = 122
const AN_CLASS_FIELD: i64 = 123
const AN_ENUM: i64 = 128
const AN_SEGMENT: i64 = 22
const AN_NAMED_TYPE: i64 = 200

// ---- 分析状态（文件顶层全局：tie namespace 体内不允许 var/const）----

// 诊断缓存（文件级增量）：uri 表 + 指纹/JSON/ok 平行表
var g_diag_uris: table<string>
var g_diag_fps: table<string>
var g_diag_json: table<string>
var g_diag_ok: table<i64>

// 符号索引（每文档一段：扁平平行表 + 段偏移/计数）
var g_iuris: table<string>
var g_ioff: table<i64>
var g_icnt: table<i64>
var g_inames: table<string>
var g_ikinds: table<string>
var g_isigs: table<string>
var g_ilines: table<i64>
var g_icols: table<i64>

// import 图（正）：文档 → 依赖文件清单（\n 分隔）
var g_dep_uris: table<string>
var g_dep_list: table<string>

// 打开文档文本存储（跨文件引用/重命名扫描用；server 的 set_doc/get_doc 委托）
var g_txt_uris: table<string>
var g_txts: table<string>

// ==================== p.9.16.2/.4 内存工程：配置 / 释放统计 / 常驻 LRU ====================
// 配置一律走环境变量，**默认值保守**（lazy 开、其余 0=关）⇒ 无参启动行为逐字节不变。
var g_cfg_lazy: i64 = -1          // TSP_LAZY：1(默认)=分析产出后立即释放前端 AST；0=保留（A/B 对照）
var g_cfg_debounce: i64 = -1      // TSP_DEBOUNCE_MS：didChange 重析合并窗口（毫秒；0=关，默认）
var g_cfg_maxdocs: i64 = -1       // TSP_MAX_OPEN_DOCS：常驻文档数上限（0=不限，默认）
var g_cfg_budget: i64 = -1        // TSP_MEM_BUDGET：常驻内存预算（字节，软指标；0=不限，默认）
var g_cfg_evicttext: i64 = -1     // TSP_EVICT_TEXT：LRU 回收是否含全文（0=默认否，见 evict_doc）
// 释放统计（验收报告用；非功能路径）。
var g_rel_gens: i64 = 0           // 已释放的「分析代」数
var g_rel_nodes: i64 = 0          // 累计释放的 AST 节点数（= 释放前 s_n 求和，回收量指标）
// 常驻生命周期（LRU）：uri → 最近访问时刻（clock 毫秒）。
var g_lru_uris: table<string>
var g_lru_when: table<i64>
var g_evicted: i64 = 0            // 已回收文档数
// didChange 防抖：uri → 上次变更时刻（clock 毫秒）。
var g_chg_uris: table<string>
var g_chg_when: table<i64>

// 单调时钟（毫秒）。MSVC 的 clock() = 进程启动以来的墙钟 × CLOCKS_PER_SEC(=1000)
// ⇒ 毫秒精度且**含等待输入的墙钟时间**（正是防抖/LRU 需要的语义；libc time() 只有秒）。
// `clock` 已在编译器 is_libc_sym 白名单内（不引入 E00888），且 tsp 非编译器 ⇒ 无自举死锁。
unsafe extern fn clock() -> i64;

namespace tsp_an {

// ==================== 文档文本存储（跨文件扫描） ====================

func txt_find(uri: string) -> i64 {
    var i: i64 = 0
    while i < len(g_txt_uris) {
        if g_txt_uris[i] == uri {
            return i
        }
        i = i + 1
    }
    return -1
}

// 存入/更新文档文本（didOpen/didChange 调用）。
pub func store_text(uri: string, txt: string) {
    var idx = txt_find(uri)
    if idx >= 0 {
        g_txts[idx] = txt
    } else {
        table_push(g_txt_uris, uri)
        table_push(g_txts, txt)
    }
}

// 取文档文本（未打开返回 ""）。
pub func fetch_text(uri: string) -> string {
    var idx = txt_find(uri)
    if idx >= 0 {
        return g_txts[idx]
    }
    return ""
}

// 移除文档文本（didClose 调用）。
pub func drop_text(uri: string) {
    var idx = txt_find(uri)
    if idx >= 0 {
        var nu = table_new_string()
        var nt = table_new_string()
        var i: i64 = 0
        while i < len(g_txt_uris) {
            if i != idx {
                table_push(nu, g_txt_uris[i])
                table_push(nt, g_txts[i])
            }
            i = i + 1
        }
        g_txt_uris = nu
        g_txts = nt
    }
}

// ==================== 诊断缓存（文件级增量） ====================

func diag_find(uri: string) -> i64 {
    var i: i64 = 0
    while i < len(g_diag_uris) {
        if g_diag_uris[i] == uri {
            return i
        }
        i = i + 1
    }
    return -1
}

func diag_set(uri: string, fp: string, json: string, ok: i64) {
    var idx = diag_find(uri)
    if idx >= 0 {
        g_diag_fps[idx] = fp
        g_diag_json[idx] = json
        g_diag_ok[idx] = ok
    } else {
        table_push(g_diag_uris, uri)
        table_push(g_diag_fps, fp)
        table_push(g_diag_json, json)
        table_push(g_diag_ok, ok)
    }
}

func diag_get(uri: string, fp: string) -> string {
    var idx = diag_find(uri)
    if idx >= 0 && g_diag_fps[idx] == fp {
        return g_diag_json[idx]
    }
    return ""
}

// 文本指纹：FNV-1a 64 位（字节级）+ 长度，字符串拼接组装。
// str_byte O(1)：str_char 逐码点遍历大文档 O(n²)（97KB 17s）。
pub func fingerprint(txt: string) -> string {
    var h: i64 = 1469598103934665603   // FNV offset basis（i64 溢出自然环绕）
    var n = len(txt)
    var i: i64 = 0
    while i < n {
        h = (h * 1099511628211) & 0x7FFFFFFFFFFFFFFF
        h = h ^ (str_byte(txt, i) & 0xFF)
        i = i + 1
    }
    return to_string(n) + ":" + to_string(h)
}

// ==================== 诊断 JSON 构造 ====================

// 单条诊断（severity：1=error 2=warning；range 单字符点）。
func mk_diag(line: i64, col: i64, msg: string, severity: i64) -> string {
    var l0 = line - 1
    var c0 = col - 1
    if l0 < 0 {
        l0 = 0
    }
    if c0 < 0 {
        c0 = 0
    }
    return "{\"range\":{\"start\":{\"line\":" + to_string(l0) + ",\"character\":" + to_string(c0) +
           "},\"end\":{\"line\":" + to_string(l0) + ",\"character\":" + to_string(c0 + 1) + "}}," +
           "\"severity\":" + to_string(severity) + ",\"source\":\"tsp\",\"message\":" +
           proto.json_str(msg) + "}"
}

// 错误诊断数组（编译器 ERR 协议 → JSON 数组）。
// 格式：ERR:<line> <col> <msg>（line/col 1-based）。返回 "[...]"。
// 字节级扫描（str_char 中文字节位死循环）。
pub func err_to_diag(proto_err: string) -> string {
    var rest = proto_err
    var n = len(rest)
    var i: i64 = 4   // 跳过 "ERR:"
    while i < n && str_byte(rest, i) != 32 {
        i = i + 1
    }
    var line = an_parse_num(an_substr(rest, 4, i))
    while i < n && str_byte(rest, i) == 32 {
        i = i + 1
    }
    var j = i
    while j < n && str_byte(rest, j) != 32 {
        j = j + 1
    }
    var col = an_parse_num(an_substr(rest, i, j))
    while j < n && str_byte(rest, j) == 32 {
        j = j + 1
    }
    var msg = an_substr(rest, j, n)
    return "[" + mk_diag(line, col, msg, 1) + "]"
}

// 解析 10 进制正整数（非数字返回 0；字节级）。
func an_parse_num(s: string) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < len(s) {
        var d = str_byte(s, i) - 48
        if d < 0 || d > 9 {
            break
        }
        v = v * 10 + d
        i = i + 1
    }
    return v
}

// 子串 [start, end)（钳位；**字节区间**，str_sub_bytes 一次拷贝）。
func an_substr(s: string, start: i64, end: i64) -> string {
    var a = start
    var b = end
    if a < 0 {
        a = 0
    }
    if b > len(s) {
        b = len(s)
    }
    if a >= b {
        return ""
    }
    return str_sub_bytes(s, a, b)
}

// ==================== 核心分析 ====================

// 分析文档：文本 → (诊断 JSON 数组, ok)。ok=1 表示语义检查成功（符号索引
// 可重建）；ok=0 表示词法/语法/语义错误（诊断 = 单条编译器错误）。
// 带文件级指纹缓存：文本未变返回缓存（诊断 + ok 均缓存）。
// base_dir：文档所在目录（import 相对路径解析基准，尾随 '/'）。
//
// ★ p.9.16.2：多返回一个 **fresh 标志**（1 = 本次真跑了完整前端管线 ⇒ sstate 有效，
// 可安全调 index_doc；0 = 文本未变命中指纹缓存 ⇒ sstate 未被重建）。
// 为什么必须区分（不是可选优化，是正确性）：
//   · release_ast() 之后，缓存命中的那次仍调 index_doc 会读到**空的 g_file_roots**
//     ⇒ 越界 panic（实测 `OOB an::index_doc [g_file_roots] line 413 idx 0 len 0`）；
//   · 即便不释放，命中缓存却重建索引也会**静默用上一个文档的陈旧 sstate**建索引
//     （各文档索引互相污染）——这是改造前就潜伏的缺陷，释放 AST 把它变成响的。
pub func analyze_ex(uri: string, txt: string, base_dir: string) -> (string, i64, i64) {
    var fp = fingerprint(txt)
    var idx = diag_find(uri)
    if idx >= 0 && g_diag_fps[idx] == fp {
        return (g_diag_json[idx], g_diag_ok[idx], 0)
    }
    // 剥离文件类型声明头部（type tie<X>），与真实管线同规则
    var src = strip_type_decl(txt)
    var prc = parser.parse_ast(src)
    if prc < 0 {
        var r1 = err_to_diag(parser.ast_err_protocol())
        diag_set(uri, fp, r1, 0)
        return (r1, 0, 1)
    }
    var sem = semantic.check_ast(base_dir)
    var out: string = ""
    var ok: i64 = 1
    if an_has_prefix(sem, "ERR:") {
        out = err_to_diag(sem)
        ok = 0
    } else {
        out = warns_to_diag(sem)
    }
    diag_set(uri, fp, out, ok)
    return (out, ok, 1)
}

// 兼容入口（忽略 fresh）；需要「本次是否重建了 sstate」的调用方请用 analyze_ex。
pub func analyze(uri: string, txt: string, base_dir: string) -> (string, i64) {
    var (j, ok, fresh) = analyze_ex(uri, txt, base_dir)
    return (j, ok)
}

// 便捷入口：仅返回诊断 JSON（忽略 ok）。
pub func analyze_doc(uri: string, txt: string, base_dir: string) -> string {
    var (j, ok) = analyze(uri, txt, base_dir)
    return j
}

// 按需重跑编译流水线（引用/语义令牌等需要新鲜 sstate AST 的功能用）。
// 成功返回 1（sstate 表为本文档最新状态）；词法/语法/语义错误返回 0。
// 注意：不触碰诊断缓存（tsp_an 诊断表独立于 sstate）。
pub func run_check(txt: string, base_dir: string) -> i64 {
    var src = strip_type_decl(txt)
    var prc = parser.parse_ast(src)
    if prc < 0 {
        return 0
    }
    var sem = semantic.check_ast(base_dir)
    if an_has_prefix(sem, "ERR:") {
        return 0
    }
    return 1
}

// 语义 OK 协议中的警告段 → 诊断数组（severity 2）。无警告返回 "[]"。
// 字节级（警告消息含中文；str_char 中文字节位死循环）。
// 推进方式对齐 driver.print_warns：每轮 rest = head（否则 p 相对 head 却
// 套回 rest，死循环）。
func warns_to_diag(sem: string) -> string {
    var items: table<string> = table_new_string()
    var rest = sem
    var p = an_find_str(rest, ";W:")
    while p >= 0 {
        var head = an_substr(rest, p + 3, len(rest))
        var sp1 = an_find_char(head, " ")
        var sp2: i64 = -1
        var i: i64 = 0
        if sp1 >= 0 {
            i = sp1 + 1
            var hn: i64 = len(head)
            while i < hn {
                if str_byte(head, i) == 32 {
                    sp2 = i
                    break
                }
                i = i + 1
            }
        }
        if sp1 >= 0 && sp2 >= 0 {
            var line = an_parse_num(an_substr(head, 0, sp1))
            var col = an_parse_num(an_substr(head, sp1 + 1, sp2))
            var core = an_substr(head, sp2 + 1, len(head))
            // 消息到下一个 ";W:" 前截断
            var nx = an_find_str(core, ";W:")
            if nx >= 0 {
                core = an_substr(core, 0, nx)
            }
            table_push(items, mk_diag(line, col, core, 2))
        }
        rest = head
        p = an_find_str(rest, ";W:")
    }
    var out: string = "["
    var k: i64 = 0
    while k < len(items) {
        if k > 0 {
            out = out + ","
        }
        out = out + items[k]
        k = k + 1
    }
    out = out + "]"
    return out
}

// ==================== 符号索引（p.6.9.4 基础） ====================
// 每文档一段：扁平平行表 + 段偏移/计数。check 成功后重建。
// （表声明在文件顶层，见文件头）

func idx_find(uri: string) -> i64 {
    var i: i64 = 0
    while i < len(g_iuris) {
        if g_iuris[i] == uri {
            return i
        }
        i = i + 1
    }
    return -1
}

func add_sym(name: string, kind: string, sig: string, line: i64, col: i64) {
    table_push(g_inames, name)
    table_push(g_ikinds, kind)
    table_push(g_isigs, sig)
    table_push(g_ilines, line)
    table_push(g_icols, col)
}

// 重建文档符号段：清旧段（重建扁平表）→ 遍历主文件顶层收集。
// 前置：**本次** semantic.check_ast 成功（sstate 表有效，g_file_roots[0] = 主文件根）。
// ★ p.9.16.2：命中指纹缓存（未重建 sstate）时**不得**调用本函数——那时 s_* 表要么是
// 空的（release_ast 之后），要么属于别的文档（陈旧 sstate）。调用方用 analyze_ex 的
// fresh 标志门控。另加空表守卫：g_file_roots 为空即直接返回（防御，不再越界 panic）。
pub func index_doc(uri: string) -> i64 {
    if len(g_file_roots) == 0 {
        return 0
    }
    var idx = idx_find(uri)
    remove_segment(idx)
    var start = len(g_inames)
    // 收集主文件顶层声明
    collect_tops(g_file_roots[0], "")
    var cnt = len(g_inames) - start
    if idx >= 0 {
        g_ioff[idx] = start
        g_icnt[idx] = cnt
    } else {
        table_push(g_iuris, uri)
        table_push(g_ioff, start)
        table_push(g_icnt, cnt)
    }
    // import 图（正）：依赖文件清单（g_imported 本轮分析结果）
    set_deps(uri)
    return cnt
}

// 移除文档的全部分析状态（索引段 + 依赖 + 诊断缓存）。
pub func drop_doc(uri: string) {
    var idx = idx_find(uri)
    remove_segment(idx)
    if idx >= 0 {
        // 移除 uri 表项（重建）
        var nu = table_new_string()
        var no = table_new_i64()
        var nc = table_new_i64()
        var i: i64 = 0
        while i < len(g_iuris) {
            if i != idx {
                table_push(nu, g_iuris[i])
                table_push(no, g_ioff[i])
                table_push(nc, g_icnt[i])
            }
            i = i + 1
        }
        g_iuris = nu
        g_ioff = no
        g_icnt = nc
    }
    // 移除依赖项
    var di = -1
    var j: i64 = 0
    while j < len(g_dep_uris) {
        if g_dep_uris[j] == uri {
            di = j
            break
        }
        j = j + 1
    }
    if di >= 0 {
        var ndu = table_new_string()
        var ndl = table_new_string()
        var k: i64 = 0
        while k < len(g_dep_uris) {
            if k != di {
                table_push(ndu, g_dep_uris[k])
                table_push(ndl, g_dep_list[k])
            }
            k = k + 1
        }
        g_dep_uris = ndu
        g_dep_list = ndl
    }
    // 移除诊断缓存
    var dgi = diag_find(uri)
    if dgi >= 0 {
        var n1 = table_new_string()
        var n2 = table_new_string()
        var n3 = table_new_string()
        var n4 = table_new_i64()
        var m: i64 = 0
        while m < len(g_diag_uris) {
            if m != dgi {
                table_push(n1, g_diag_uris[m])
                table_push(n2, g_diag_fps[m])
                table_push(n3, g_diag_json[m])
                table_push(n4, g_diag_ok[m])
            }
            m = m + 1
        }
        g_diag_uris = n1
        g_diag_fps = n2
        g_diag_json = n3
        g_diag_ok = n4
    }
}

// 移除下标 idx 的符号段（扁平表重建）；idx < 0 不做。
func remove_segment(idx: i64) {
    if idx < 0 {
        return
    }
    var removed = g_ioff[idx]
    var nn: table<string> = table_new_string()
    var nk: table<string> = table_new_string()
    var ns: table<string> = table_new_string()
    var nl: table<i64> = table_new_i64()
    var nc: table<i64> = table_new_i64()
    var i: i64 = 0
    while i < len(g_inames) {
        if i < removed || i >= removed + g_icnt[idx] {
            table_push(nn, g_inames[i])
            table_push(nk, g_ikinds[i])
            table_push(ns, g_isigs[i])
            table_push(nl, g_ilines[i])
            table_push(nc, g_icols[i])
        }
        i = i + 1
    }
    g_inames = nn
    g_ikinds = nk
    g_isigs = ns
    g_ilines = nl
    g_icols = nc
}

// 记录文档的 import 依赖（g_imported 归一化路径）。
// （g_dep_uris/g_dep_list 声明在文件顶层）

// 依赖表按 uri 定位（-1 = 无）；set_deps/doc_imports/doc_bytes 共用。
func dep_find(uri: string) -> i64 {
    var i: i64 = 0
    while i < len(g_dep_uris) {
        if g_dep_uris[i] == uri {
            return i
        }
        i = i + 1
    }
    return -1
}

func set_deps(uri: string) {
    var idx = -1
    var i: i64 = 0
    while i < len(g_dep_uris) {
        if g_dep_uris[i] == uri {
            idx = i
            break
        }
        i = i + 1
    }
    var list: string = ""
    var k: i64 = 0
    while k < len(g_imported) {
        if k > 0 {
            list = list + "\n"
        }
        list = list + g_imported[k]
        k = k + 1
    }
    if idx >= 0 {
        g_dep_list[idx] = list
    } else {
        table_push(g_dep_uris, uri)
        table_push(g_dep_list, list)
    }
}

// 查询：文档是否依赖给定文件（归一化路径精确匹配）。
pub func doc_imports(uri: string, file: string) -> bool {
    var idx = -1
    var i: i64 = 0
    while i < len(g_dep_uris) {
        if g_dep_uris[i] == uri {
            idx = i
            break
        }
        i = i + 1
    }
    if idx < 0 {
        return false
    }
    var list = g_dep_list[idx]
    var j: i64 = 0
    while j < len(list) {
        var le = j
        while le < len(list) && str_byte(list, le) != 10 {
            le = le + 1
        }
        if an_substr(list, j, le) == file {
            return true
        }
        j = le + 1
    }
    return false
}

// 递归收集顶层声明（含 namespace 递归）。
func collect_tops(root: i64, prefix: string) {
    var nc = s_nchild[root]
    var base = s_coff[root]
    var k: i64 = 0
    while k < nc {
        var c = s_children[base + k]
        if c >= 0 {
            var tag = s_tags[c]
            if tag == AN_FN_DEF {
                add_sym(prefix + intern.lookup(s_names[c]), "func", fn_sig(c), s_lines[c], s_cols[c])
            } else if tag == AN_STRUCT {
                add_sym(prefix + intern.lookup(s_names[c]), "struct", "", s_lines[c], s_cols[c])
            } else if tag == AN_ENUM {
                add_sym(prefix + intern.lookup(s_names[c]), "enum", "", s_lines[c], s_cols[c])
            } else if tag == AN_VAR_DECL {
                add_sym(prefix + intern.lookup(s_names[c]), "global", "", s_lines[c], s_cols[c])
            } else if tag == AN_EXTERN {
                add_sym(prefix + intern.lookup(s_names[c]), "extern", "", s_lines[c], s_cols[c])
            } else if tag == AN_NAMESPACE {
                var nsegs = s_aux[c]
                var segbase = s_coff[c]
                var full = prefix
                var si: i64 = 0
                while si < nsegs {
                    var seg = s_children[segbase + si]
                    if seg >= 0 {
                        full = full + intern.lookup(s_names[seg]) + "."
                    }
                    si = si + 1
                }
                add_sym(full, "namespace", "", s_lines[c], s_cols[c])
                // 递归：body = 第 nsegs 个子节点（N_STMTLIST）
                if nsegs < s_nchild[c] {
                    var body = s_children[segbase + nsegs]
                    if body >= 0 && s_tags[body] == AN_STMTLIST {
                        collect_tops(body, full)
                    }
                }
            }
        }
        k = k + 1
    }
}

// 函数签名文本（AST 重建：泛型槽 + 返回类型 + 参数 + body 布局）。
func fn_sig(node: i64) -> string {
    var name = intern.lookup(s_names[node])
    var out = "func " + name
    var nc = s_nchild[node]
    var base = s_coff[node]
    var ret: string = ""
    var i: i64 = 1
    if nc > 1 {
        var c1 = s_children[base + 1]
        if c1 >= 0 && s_tags[c1] != AN_PARAM && s_tags[c1] != AN_STMTLIST {
            ret = type_text(c1)
            i = 2
        }
    }
    out = out + "("
    var first: bool = true
    while i < nc {
        var c = s_children[base + i]
        if c < 0 || s_tags[c] != AN_PARAM {
            break
        }
        if !first {
            out = out + ", "
        }
        first = false
        var pname = intern.lookup(s_names[c])
        out = out + pname
        if s_nchild[c] > 0 {
            var pt = type_text(s_children[s_coff[c]])
            if len(pt) > 0 {
                out = out + ": " + pt
            }
        }
        i = i + 1
    }
    out = out + ")"
    if len(ret) > 0 {
        out = out + " -> " + ret
    }
    return out
}

// 类型节点 → 文本（N_NAMED_TYPE 取池名；N_PATH 拼接段；其余回退 "?"）。
func type_text(node: i64) -> string {
    if node < 0 {
        return ""
    }
    var tag = s_tags[node]
    if tag == AN_NAMED_TYPE {
        return intern.lookup(s_names[node])
    }
    if tag == AN_PATH {
        var out: string = ""
        var nc = s_nchild[node]
        var base = s_coff[node]
        var k: i64 = 0
        while k < nc {
            var c = s_children[base + k]
            if c >= 0 {
                if len(out) > 0 {
                    out = out + "."
                }
                out = out + intern.lookup(s_names[c])
            }
            k = k + 1
        }
        return out
    }
    if tag == AN_VAR {
        return intern.lookup(s_names[node])
    }
    return "?"
}

// ==================== 查询接口（hover/completion/definition 用） ====================

// 文档符号数（-1 = 未索引）。
pub func sym_count(uri: string) -> i64 {
    var idx = idx_find(uri)
    if idx < 0 {
        return -1
    }
    return g_icnt[idx]
}

func sym_at(uri: string, i: i64) -> i64 {
    var idx = idx_find(uri)
    if idx < 0 || i < 0 || i >= g_icnt[idx] {
        return -1
    }
    return g_ioff[idx] + i
}

pub func sym_name(uri: string, i: i64) -> string {
    var s = sym_at(uri, i)
    if s < 0 {
        return ""
    }
    return g_inames[s]
}

pub func sym_kind(uri: string, i: i64) -> string {
    var s = sym_at(uri, i)
    if s < 0 {
        return ""
    }
    return g_ikinds[s]
}

pub func sym_sig(uri: string, i: i64) -> string {
    var s = sym_at(uri, i)
    if s < 0 {
        return ""
    }
    return g_isigs[s]
}

pub func sym_line(uri: string, i: i64) -> i64 {
    var s = sym_at(uri, i)
    if s < 0 {
        return 0
    }
    return g_ilines[s]
}

pub func sym_col(uri: string, i: i64) -> i64 {
    var s = sym_at(uri, i)
    if s < 0 {
        return 0
    }
    return g_icols[s]
}

// 按名查符号（首个匹配；-1 = 未找到）。
pub func find_sym_named(uri: string, name: string) -> i64 {
    var n = sym_count(uri)
    var i: i64 = 0
    while i < n {
        if sym_name(uri, i) == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// 已索引文档枚举（跨文件跳转/引用用）。
pub func doc_count() -> i64 {
    return len(g_iuris)
}

pub func doc_uri(i: i64) -> string {
    if i < 0 || i >= len(g_iuris) {
        return ""
    }
    return g_iuris[i]
}

// ==================== 字符串工具 ====================
// 全部字节级（str_byte O(1)）：str_char 本运行时单次 ~360µs 且在中文字节
// 位上解码可能死循环——语义协议/警告串含中文，必须用字节下标。

func an_has_prefix(s: string, p: string) -> bool {
    if len(s) < len(p) {
        return false
    }
    var i: i64 = 0
    while i < len(p) {
        if str_byte(s, i) != str_byte(p, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 首个子串出现位置（未找到 -1；字节级）。
func an_find_str(hay: string, needle: string) -> i64 {
    if len(needle) == 0 {
        return 0
    }
    var i: i64 = 0
    while i + len(needle) <= len(hay) {
        var matched: bool = true
        var j: i64 = 0
        while j < len(needle) {
            if str_byte(hay, i + j) != str_byte(needle, j) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// 首个字符出现位置（未找到 -1；字节级，c 传单字节字符串）。
func an_find_char(s: string, c: string) -> i64 {
    if len(c) == 0 {
        return -1
    }
    var cb = str_byte(c, 0)
    var i: i64 = 0
    while i < len(s) {
        if str_byte(s, i) == cb {
            return i
        }
        i = i + 1
    }
    return -1
}

// 剥离文件类型声明行（type tie / type tie<X>）：头部 = 最前连续行
//（允许空行），声明行空行占位；其余原样。与 semantic.strip_type_decl
// 同规则（LSP 侧独立实现，避免跨模块内部函数依赖）。
pub func strip_type_decl(src: string) -> string {
    var n = len(src)
    var i: i64 = 0
    var out: string = ""
    var in_header: bool = true
    while in_header {
        var ln_s = i
        var ln_e = i
        while ln_e < n && str_byte(src, ln_e) != 10 {
            ln_e = ln_e + 1
        }
        var has_nl = ln_e < n
        var next_i = ln_e
        if has_nl {
            next_i = ln_e + 1
        }
        var t = an_trim(str_sub_bytes(src, ln_s, ln_e))
        if str_len(t) == 0 {
            out = out + str_sub_bytes(src, ln_s, next_i)
        } else if an_has_prefix(t, "type tie") {
            var rest = an_trim(an_substr(t, 8, len(t)))
            if len(rest) == 0 || (str_byte(rest, 0) == 60 && str_byte(rest, len(rest) - 1) == 62) {
                if has_nl {
                    out = out + "\n"
                }
            } else {
                out = out + str_sub_bytes(src, ln_s, n)
                in_header = false
            }
        } else {
            out = out + str_sub_bytes(src, ln_s, n)
            in_header = false
        }
        i = next_i
        if in_header && i >= n {
            in_header = false
        }
    }
    return out
}

// 去首尾空白（字节级）。
func an_trim(s: string) -> string {
    var a: i64 = 0
    var b = len(s)
    while a < b {
        var c = str_byte(s, a)
        if c == 32 || c == 9 || c == 13 {
            a = a + 1
        } else {
            break
        }
    }
    while b > a {
        var c = str_byte(s, b - 1)
        if c == 32 || c == 9 || c == 13 {
            b = b - 1
        } else {
            break
        }
    }
    return an_substr(s, a, b)
}

// ==================== p.9.16 内存工程 ====================
// 三线：① 按需 lazy + AST 释放（release_now）② 状态去冗余（server 侧重复符号索引
// 已删除，hover/大纲复用本文的 g_i* 唯一真相）③ 常驻生命周期 LRU（touch/evict_*）。
// 全部默认保守：TSP_LAZY 默认开（只影响「用完即释放」），其余默认 0=关 ⇒ 无参启动
// 行为不变（与改造前逐字节一致）。

// ---- ① 配置（环境变量；惰性求值一次并缓存）----
func cfg_num(name: string, dflt: i64) -> i64 {
    var v = get_env(name)
    if len(v) == 0 {
        return dflt
    }
    return an_parse_num(v)
}

pub func lazy_on() -> i64 {
    if g_cfg_lazy < 0 {
        g_cfg_lazy = cfg_num("TSP_LAZY", 1)
    }
    return g_cfg_lazy
}

pub func debounce_ms() -> i64 {
    if g_cfg_debounce < 0 {
        g_cfg_debounce = cfg_num("TSP_DEBOUNCE_MS", 0)
    }
    return g_cfg_debounce
}

pub func max_open_docs() -> i64 {
    if g_cfg_maxdocs < 0 {
        g_cfg_maxdocs = cfg_num("TSP_MAX_OPEN_DOCS", 0)
    }
    return g_cfg_maxdocs
}

pub func mem_budget() -> i64 {
    if g_cfg_budget < 0 {
        g_cfg_budget = cfg_num("TSP_MEM_BUDGET", 0)
    }
    return g_cfg_budget
}

pub func evict_text_on() -> i64 {
    if g_cfg_evicttext < 0 {
        g_cfg_evicttext = cfg_num("TSP_EVICT_TEXT", 0)
    }
    return g_cfg_evicttext
}

// ---- ② 用后释放前端 AST（p.9.16.2）----
// 在「本代分析所需结果已全部抽出」（诊断 JSON / 符号索引 / 依赖图都已落到本文的
// 平面表）之后调用：把前端静态表 s_* 列式 AST + intern 池 + parser 节点池一并
// 回退到空始态 ⇒ 常驻不再随文档数线性增长（峰值只存在于单次分析期间）。
// TSP_LAZY=0 时不释放（保留 AST，供 A/B 对照与调试）。
// ⚠ 释放后**不得**再读 s_* / g_file_roots / intern：本文的 index_doc/collect_tops
//   必须在释放前完成（当前调用点均在 index_doc 之后）。
pub func release_now() {
    if lazy_on() == 0 {
        return
    }
    g_rel_gens = g_rel_gens + 1
    g_rel_nodes = g_rel_nodes + s_n
    semantic.release_ast()
}

pub func release_gens() -> i64 {
    return g_rel_gens
}

pub func release_nodes() -> i64 {
    return g_rel_nodes
}

// ---- ③ 常驻生命周期：LRU 记账 ----
func lru_now() -> i64 {
    var t: i64 = 0
    unsafe {
        t = clock()
    }
    return t
}

func lru_find(uri: string) -> i64 {
    var i: i64 = 0
    while i < len(g_lru_uris) {
        if g_lru_uris[i] == uri {
            return i
        }
        i = i + 1
    }
    return -1
}

// 记录一次访问（didOpen/didChange/任意请求命中该文档）。
pub func touch(uri: string) {
    if len(uri) == 0 {
        return
    }
    var t = lru_now()
    var i = lru_find(uri)
    if i >= 0 {
        g_lru_when[i] = t
    } else {
        table_push(g_lru_uris, uri)
        table_push(g_lru_when, t)
    }
}

func lru_forget(uri: string) {
    var i = lru_find(uri)
    if i < 0 {
        return
    }
    var nu = table_new_string()
    var nw = table_new_i64()
    var j: i64 = 0
    while j < len(g_lru_uris) {
        if j != i {
            table_push(nu, g_lru_uris[j])
            table_push(nw, g_lru_when[j])
        }
        j = j + 1
    }
    g_lru_uris = nu
    g_lru_when = nw
}

func lru_time_of(uri: string) -> i64 {
    var i = lru_find(uri)
    if i < 0 {
        return 0
    }
    return g_lru_when[i]
}

func in_str_list(t: table<string>, v: string) -> bool {
    var i: i64 = 0
    while i < len(t) {
        if t[i] == v {
            return true
        }
        i = i + 1
    }
    return false
}

// 单文档近似驻留字节（文本 + 诊断缓存 + 依赖清单）。用途是 LRU 的**软指标**
// （排序与阈值判定），不是精确分配量。
func doc_bytes(uri: string) -> i64 {
    var b: i64 = 0
    var ti = txt_find(uri)
    if ti >= 0 {
        b = b + len(g_txts[ti])
    }
    var di = diag_find(uri)
    if di >= 0 {
        b = b + len(g_diag_json[di]) + len(g_diag_fps[di])
    }
    var pi = dep_find(uri)
    if pi >= 0 {
        b = b + len(g_dep_list[pi])
    }
    return b
}

pub func resident_docs() -> i64 {
    return len(g_txt_uris)
}

pub func resident_bytes() -> i64 {
    var b: i64 = 0
    var i: i64 = 0
    while i < len(g_txt_uris) {
        b = b + doc_bytes(g_txt_uris[i])
        i = i + 1
    }
    return b
}

pub func evicted_count() -> i64 {
    return g_evicted
}

// p.9.16.5 验收自述：内存工程的可观测度量（供 `tsp/stats` 自定义方法直接回给探针/报告）。
// 存在的理由：内存本身难断言（分配器保留使 WS 变化被掩盖），而「常驻文档数 / 已回收数 /
// 已释放代数」是**确定性**的 ⇒ 用它证明旋钮真的被读取并生效（名字兑现承诺）。
pub func stats_json() -> string {
    return "{\"residentDocs\":" + to_string(resident_docs()) +
           ",\"residentBytes\":" + to_string(resident_bytes()) +
           ",\"releasedGens\":" + to_string(g_rel_gens) +
           ",\"releasedNodes\":" + to_string(g_rel_nodes) +
           ",\"evicted\":" + to_string(g_evicted) +
           ",\"lazy\":" + to_string(lazy_on()) +
           ",\"debounceMs\":" + to_string(debounce_ms()) +
           ",\"maxOpenDocs\":" + to_string(max_open_docs()) +
           ",\"memBudget\":" + to_string(mem_budget()) +
           ",\"evictText\":" + to_string(evict_text_on()) + "}"
}

// 回收单文档的常驻分析状态（LRU 淘汰动作）。
// 层级（设计 §4.4「回收粒度可配」的落地）：
//   · 默认（TSP_EVICT_TEXT=0）：只丢**可重算**的派生态——符号索引 + 依赖图 + 诊断缓存；
//     全文保留（编辑器的未保存缓冲不可丢：丢了就无法重算，而 LSP 没有其它来源）。
//   · TSP_EVICT_TEXT=1：连同全文一并丢；下次访问由 ensure_text 从磁盘冷重建
//     （⚠ 对未保存的缓冲是**有损**的，故默认关）。
func evict_doc(uri: string) {
    drop_doc(uri)
    if evict_text_on() == 1 {
        drop_text(uri)
    }
    lru_forget(uri)
    g_evicted = g_evicted + 1
}

// 超限即按 LRU 回收（最久未访问者优先），直到回到限内或无可回收者。
// 两个开关都为 0（默认）时**立即返回** ⇒ 零额外开销、行为不变。
pub func evict_if_needed() {
    var md = max_open_docs()
    var mb = mem_budget()
    if md == 0 && mb == 0 {
        return
    }
    var done = table_new_string()
    var guard: i64 = 0
    var n0 = len(g_txt_uris)
    while guard <= n0 {
        var n = len(g_txt_uris)
        var over_docs = false
        if md > 0 && n > md {
            over_docs = true
        }
        var over_mem = false
        if mb > 0 && resident_bytes() > mb {
            over_mem = true
        }
        if !over_docs && !over_mem {
            return
        }
        // 选「最久未访问且尚未回收」的文档
        var victim: string = ""
        var best: i64 = -1
        var i: i64 = 0
        while i < n {
            var u = g_txt_uris[i]
            if !in_str_list(done, u) {
                var w = lru_time_of(u)
                if best < 0 || w < best {
                    best = w
                    victim = u
                }
            }
            i = i + 1
        }
        if len(victim) == 0 {
            return
        }
        evict_doc(victim)
        table_push(done, victim)
        guard = guard + 1
    }
}

// uri → 本地文件路径（file:// 前缀与前导斜杠剥离；非 file uri 返回空串）。
pub func uri_fs_path(uri: string) -> string {
    var p = uri
    if an_has_prefix(p, "file://") {
        p = an_substr(p, 7, len(p))
    }
    while len(p) > 0 && (str_byte(p, 0) == 47 || str_byte(p, 0) == 92) {
        p = an_substr(p, 1, len(p))
    }
    return p
}

// 取文档文本：常驻在则直回；已被 LRU 回收（TSP_EVICT_TEXT=1）则**冷重建**——
// 从磁盘读回并重新驻留。冷重建是「丢全文」这一档的必要配套（设计 §4.4）。
pub func ensure_text(uri: string) -> string {
    var t = fetch_text(uri)
    if len(t) > 0 {
        return t
    }
    var p = uri_fs_path(uri)
    if len(p) == 0 {
        return ""
    }
    if !file_exists(p) {
        return ""
    }
    var s = file_read(p)
    if len(s) > 0 {
        store_text(uri, s)
        touch(uri)
    }
    return s
}

// ---- didChange 防抖（p.9.16.2）----
// 该文档上次变更是否落在防抖窗口内（窗口内 ⇒ 本此变更**合并**、暂不重析）。
pub func changed_recently(uri: string) -> bool {
    var win = debounce_ms()
    if win <= 0 {
        return false
    }
    var i: i64 = 0
    while i < len(g_chg_uris) {
        if g_chg_uris[i] == uri {
            return (lru_now() - g_chg_when[i]) < win
        }
        i = i + 1
    }
    return false
}

pub func mark_change(uri: string) {
    var t = lru_now()
    var i: i64 = 0
    while i < len(g_chg_uris) {
        if g_chg_uris[i] == uri {
            g_chg_when[i] = t
            return
        }
        i = i + 1
    }
    table_push(g_chg_uris, uri)
    table_push(g_chg_when, t)
}

}   // namespace tsp_an
